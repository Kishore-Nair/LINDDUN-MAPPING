.ruff_cache/
.coverage
htmlcov/

# --- Editors / tooling -----------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~

# --- Claude Code workspace -------------------------------------------------
# .claude/ holds a git worktree belonging to a DIFFERENT repository
# (the home-directory repo). It must never be committed here.
.claude/

# --- Vendored upstream history ---------------------------------------------
# c3_vulmap_v2/ is vendored from https://github.com/juxam/C3-VULMAP (CC0 1.0).
# Its original .git was renamed aside so the files could be tracked here as
# normal content. Keep that history local; do not publish it.
c3_vulmap_v2/.git.upstream-backup/

